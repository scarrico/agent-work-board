{
  "identity": {
    "agentName": "agent_mcp_broker",
    "displayName": "Agent MCP Broker",
    "description": "Uses Blocks/PubNub as an optional transport for registered MCP-style tools, so Brain, Kanban, Scrum, status, and optional Massive data-plane services can run on one machine and be used remotely without inbound HTTP, SSH, VPN, or shared filesystems.",
    "version": "1.0.0",
    "documentationUrl": "https://github.com/scarrico/agent-work-board/tree/main/agent_mcp_broker",
    "repositoryUrl": "https://github.com/scarrico/agent-work-board",
    "provider": {
      "organization": "agent_mcp_broker"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "MCP-style broker request.",
        "contentType": "application/json",
        "required": true,
        "example": {
          "request_id": "demo-1",
          "tool": "kanban.counts",
          "arguments": {
            "backend": "jira",
            "board_id": "work"
          }
        },
        "schema": {
          "type": "object",
          "required": [
            "tool"
          ],
          "properties": {
            "request_id": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "arguments": {
              "type": "object"
            }
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "result",
        "description": "Brokered tool result.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "skills": [
    {
      "id": "main",
      "name": "MCP Tool Broker",
      "description": "Routes registered MCP-style JSON tool calls through Blocks/PubNub so agents can use hosted Brain, board, and data-plane services across machines without changing tool names."
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 8,
    "expectedInstances": 1
  }
}
