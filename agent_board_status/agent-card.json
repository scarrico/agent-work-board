{
  "identity": {
    "agentName": "agent_board_status",
    "displayName": "Agent Board Status",
    "description": "Summarizes Kanban or Scrum board state using optional agent_brain instructions and memory.",
    "version": "1.0.0",
    "documentationUrl": "https://github.com/scarrico/agent-work-board/tree/main/agent_board_status",
    "repositoryUrl": "https://github.com/scarrico/agent-work-board",
    "provider": {
      "organization": "agent_board_status"
    }
  },
  "capabilities": {
    "taskKinds": [
      "request"
    ]
  },
  "io": {
    "inputs": [
      {
        "id": "request",
        "description": "Board status summary request.",
        "contentType": "application/json",
        "required": true,
        "example": {
          "board_type": "kanban",
          "backend": "sqlite",
          "board_id": "demo",
          "db_path": "demo_data/local_board_brain_demo/kanban.sqlite",
          "brain_db": "demo_data/local_board_brain_demo/brain.sqlite",
          "use_brain": true,
          "remember_summary": true
        },
        "schema": {
          "type": "object",
          "properties": {
            "board_type": {
              "type": "string",
              "enum": ["kanban", "scrum"]
            },
            "backend": {"type": "string"},
            "board_client": {"type": "string"},
            "board_id": {"type": "string"},
            "board": {"type": "string"},
            "board_url": {"type": "string"},
            "db_path": {"type": "string"},
            "sprint_id": {"type": "string"},
            "stale_minutes": {"type": "integer"},
            "max_cards": {"type": "integer"},
            "use_brain": {"type": "boolean"},
            "brain_db": {"type": "string"},
            "brain_client": {"type": "string"},
            "instruction_scope": {"type": "string"},
            "instruction_cadence": {
              "type": "string",
              "enum": ["daily", "weekly", "always"]
            },
            "instruction_tool": {"type": "string"},
            "instruction_project": {"type": "string"},
            "instruction_effective_on": {"type": "string"},
            "remember_summary": {"type": "boolean"},
            "write_card": {"type": "boolean"},
            "write_story": {"type": "boolean"},
            "use_llm": {"type": "boolean"},
            "actor": {"type": "string"},
            "ssh_host": {"type": "string"},
            "ssh_root": {"type": "string"},
            "ssh_python": {"type": "string"},
            "ssh_user": {"type": "string"},
            "ssh_port": {"type": "integer"},
            "ssh_key": {"type": "string"},
            "brain_ssh_host": {"type": "string"},
            "brain_ssh_root": {"type": "string"},
            "brain_ssh_python": {"type": "string"},
            "brain_ssh_user": {"type": "string"},
            "brain_ssh_port": {"type": "integer"},
            "brain_ssh_key": {"type": "string"}
          }
        }
      }
    ],
    "outputs": [
      {
        "id": "result",
        "description": "Board status summary result.",
        "contentType": "application/json",
        "guaranteed": true
      }
    ]
  },
  "skills": [
    {
      "id": "main",
      "name": "Board Status Summary",
      "description": "Reads Kanban or Scrum board state, applies optional agent_brain instructions, and returns a concise status summary."
    }
  ],
  "runtime": {
    "handler": "./handler.ts",
    "handlerExport": "default",
    "concurrency": 2,
    "expectedInstances": 1
  }
}
